 }
 
+/*
+ * Meson8 microcode: same mailbox protocol as GXBB, start sequence of the
+ * vendor vh264_prot_init() (3.10). It resets the VLD again after the
+ * memories are powered, has no SEI buffer (AV_SCRATCH_I/J) and no
+ * AV_SCRATCH_F bit 7.
+ */
+static int codec_h264_start_meson8(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_h264 *h264 = sess->priv;
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		amvdec_write_dos(core, DOS_SW_RESET0,
+				 BIT(7) | BIT(6) | BIT(4));
+		amvdec_write_dos(core, DOS_SW_RESET0, 0);
+		amvdec_read_dos(core, DOS_SW_RESET0);
+		amvdec_read_dos(core, DOS_SW_RESET0);
+		amvdec_read_dos(core, DOS_SW_RESET0);
+	}
+	amvdec_write_dos(core, DOS_SW_RESET0, BIT(9) | BIT(8));
+	amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+
+	amvdec_write_dos_bits(core, POWER_CTL_VLD, BIT(9) | BIT(6));
+
+	/* Disable PSCALE for hardware sharing */
+	amvdec_write_dos(core, PSCALE_CTRL, 0);
+
+	amvdec_write_dos(core, AV_SCRATCH_0, 0);
+	amvdec_write_dos(core, AV_SCRATCH_1,
+			 h264->workspace_paddr - WORKSPACE_BUF_OFFSET);
+	amvdec_write_dos(core, AV_SCRATCH_G, h264->ext_fw_paddr);
+	amvdec_write_dos(core, AV_SCRATCH_7, 0);
+	amvdec_write_dos(core, AV_SCRATCH_8, 0);
+	amvdec_write_dos(core, AV_SCRATCH_9, 0);
+
+	/* Error recovery mode 1, I/P/B decoding (bit 6 clear) */
+	amvdec_write_dos(core, AV_SCRATCH_F,
+			 (amvdec_read_dos(core, AV_SCRATCH_F) & 0xffffff83) |
+			 BIT(4));
+
+	amvdec_write_dos(core, MDEC_PIC_DC_THRESH, 0x404038aa);
+
+	return 0;
+}
+
 static int codec_h264_start(struct amvdec_session *sess)
 {
 	u32 workspace_offset;
@@ -182,6 +231,9 @@
 	if (!h264->sei_vaddr)
 		return -ENOMEM;
 
+	if (vdec_is_meson8(core->platform))
+		return codec_h264_start_meson8(sess);
+
 	amvdec_write_dos_bits(core, POWER_CTL_VLD, BIT(9) | BIT(6));
 
 	workspace_offset = h264->workspace_paddr - WORKSPACE_BUF_OFFSET;
@@ -288,9 +340,13 @@
