+				(u32[]){ ANC0_CANVAS_ADDR, 0 },
+				(u32[]){ 24, 0 })) {
+		dev_err(core->dev, "Cannot set the frame canvases\n");
+		amvdec_abort(sess);
+		return;
+	}
 
 	dev_dbg(core->dev, "max_refs = %u; actual_dpb_size = %u\n",
 		h264->max_refs, sess->num_dst_bufs);
@@ -445,6 +501,11 @@
 	case 0: /* Unused but not worth printing for */
