 #define AO_RTI_GEN_PWR_ISO0	0xec
 	#define GEN_PWR_VDEC_1 (BIT(3) | BIT(2))
 	#define GEN_PWR_VDEC_1_SM1 (BIT(1))
+	#define GEN_PWR_VDEC_1_ISO (BIT(7) | BIT(6))
+
+/*
+ * Meson8: the AO syscon (&pmu) starts at AO + 0xe0, so the same registers
+ * sit at 0x08 and 0x0c in it
+ */
+#define MESON8_AO_RTI_GEN_PWR_SLEEP0	0x08
+#define MESON8_AO_RTI_GEN_PWR_ISO0	0x0c
+
+/* Highest VDEC_1 clock of the Meson8m2 vendor kernel is fclk_div4 */
+#define MESON8_VDEC_1_MAX_RATE	640000000
 
 #define MC_SIZE			(4096 * 4)
 
+static u32 vdec_1_sleep_reg(struct amvdec_core *core)
+{
+	return vdec_is_meson8(core->platform) ? MESON8_AO_RTI_GEN_PWR_SLEEP0 :
+						AO_RTI_GEN_PWR_SLEEP0;
+}
+
+static void vdec_1_isolate(struct amvdec_core *core, bool isolate)
+{
+	if (core->platform->revision == VDEC_REVISION_SM1)
+		regmap_update_bits(core->regmap_ao, AO_RTI_GEN_PWR_ISO0,
+				   GEN_PWR_VDEC_1_SM1,
+				   isolate ? GEN_PWR_VDEC_1_SM1 : 0);
+	else if (vdec_is_meson8(core->platform))
+		/* Only the VDEC_1 bits: HCODEC, VDEC_2 and HEVC share it */
+		regmap_update_bits(core->regmap_ao, MESON8_AO_RTI_GEN_PWR_ISO0,
+				   GEN_PWR_VDEC_1_ISO,
+				   isolate ? GEN_PWR_VDEC_1_ISO : 0);
+	else
+		regmap_write(core->regmap_ao, AO_RTI_GEN_PWR_ISO0,
+			     isolate ? 0xc0 : 0);
+}
+
+static void vdec_1_power(struct amvdec_core *core, bool on)
+{
+	u32 mask = core->platform->revision == VDEC_REVISION_SM1 ?
+		   GEN_PWR_VDEC_1_SM1 : GEN_PWR_VDEC_1;
+
+	regmap_update_bits(core->regmap_ao, vdec_1_sleep_reg(core), mask,
+			   on ? 0 : mask);
+}
