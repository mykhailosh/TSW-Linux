 }
 
+/*
+ * The CAPTURE queue may be set up after the firmware reported the stream
+ * parameters but before amvdec_src_change() ran: it then clears
+ * changed_format although the buffers fit, and nothing would resume the
+ * decoder (seen with ffmpeg on Meson8m2). Resume if the buffers fit.
+ */
+static bool vdec_cap_bufs_fit(struct amvdec_session *sess)
+{
+	return sess->num_dst_bufs &&
+	       sess->cap_width == sess->width &&
+	       sess->cap_height == sess->height &&
+	       sess->num_dst_bufs >= v4l2_ctrl_g_ctrl(sess->ctrl_min_buf_capture);
+}
+
 static void vdec_vb2_buf_queue(struct vb2_buffer *vb)
 {
 	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
@@ -301,7 +325,7 @@
 
 	if (sess->status == STATUS_NEEDS_RESUME &&
 	    q->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
-	    sess->changed_format) {
+	    (sess->changed_format || vdec_cap_bufs_fit(sess))) {
 		codec_ops->resume(sess);
 		sess->status = STATUS_RUNNING;
 		return 0;
@@ -312,6 +336,18 @@
 	    sess->status == STATUS_INIT)
 		return 0;
 
+	/*
+	 * A new decoding session: claim the core. Two sessions can get here at
+	 * once (each holds only its own lock): with a plain check both powered
+	 * the decoder on, and the first one to stop powered it off under the
+	 * other, whose next DOS register access hung the bus (seen with two
+	 * players on Meson8m2).
+	 */
+	if (cmpxchg(&core->cur_sess, NULL, sess)) {
+		ret = -EBUSY;
+		goto bufs_done;
+	}
+
 	sess->vififo_size = SIZE_VIFIFO;
 	sess->vififo_vaddr =
 		dma_alloc_coherent(sess->core->dev, sess->vififo_size,
@@ -319,7 +355,7 @@
 	if (!sess->vififo_vaddr) {
 		dev_err(sess->core->dev, "Failed to request VIFIFO buffer\n");
 		ret = -ENOMEM;
-		goto bufs_done;
+		goto release_core;
 	}
 
 	sess->should_stop = 0;
@@ -342,13 +378,14 @@
 						   "vdec_recycle");
 
 	sess->status = STATUS_INIT;
-	core->cur_sess = sess;
 	schedule_work(&sess->esparser_queue_work);
 	return 0;
 
 vififo_free:
 	dma_free_coherent(sess->core->dev, sess->vififo_size,
 			  sess->vififo_vaddr, sess->vififo_paddr);
+release_core:
+	WRITE_ONCE(core->cur_sess, NULL);
 bufs_done:
 	while ((buf = v4l2_m2m_src_buf_remove(sess->m2m_ctx)))
 		v4l2_m2m_buf_done(buf, VB2_BUF_STATE_QUEUED);
@@ -990,6 +1027,8 @@
 	  .data = &vdec_platform_g12a },
 	{ .compatible = "amlogic,sm1-vdec",
 	  .data = &vdec_platform_sm1 },
+	{ .compatible = "amlogic,meson8m2-vdec",
+	  .data = &vdec_platform_meson8m2 },
 	{}
 };
 MODULE_DEVICE_TABLE(of, vdec_dt_match);
