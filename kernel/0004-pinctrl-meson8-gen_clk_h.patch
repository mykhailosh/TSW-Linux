Subject: pinctrl: meson8: add the GEN_CLK output on GPIOH_9

From tsx-mainline/linux.

diff --git a/drivers/pinctrl/meson/pinctrl-meson8.c b/drivers/pinctrl/meson/pinctrl-meson8.c
index 3da7f37..414a2f4 100644
--- a/drivers/pinctrl/meson/pinctrl-meson8.c
+++ b/drivers/pinctrl/meson/pinctrl-meson8.c
@@ -285,6 +285,8 @@ static const unsigned int spi_sclk_0_pins[]	= { GPIOH_6 };
 static const unsigned int i2c_sda_d1_pins[]	= { GPIOH_7 };
 static const unsigned int i2c_sck_d1_pins[]	= { GPIOH_8 };
 
+static const unsigned int gen_clk_h_pins[]	= { GPIOH_9 };
